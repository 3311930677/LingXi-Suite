# Rust build artifacts (root workspace + any nested target dirs, e.g. apps/overlay)
/target
**/target/
**/*.rs.bk

# Toolchain installers
rustup-init.exe

# Local temporary verification / build outputs
*-check.out
*-check.err
*-clippy-out.txt
*-test-out.txt
*.out
run-*-clippy.bat
run-*-tests.bat

# Environment / installer logs
vcenv.txt
vs-install.log
vs-install.log.err
*.log

# OS / editor cruft
Thumbs.db
.DS_Store

# Engine binary copied for bundling (see apps/overlay/scripts/prepare-engine-dist.ps1)
apps/overlay/engine-dist/
